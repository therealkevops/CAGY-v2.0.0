{
  "name": "agy-docker-webui",
  "version": "2.0.0",
  "private": true,
  "description": "Containerized Antigravity (CAGY) Web UI and development environment",
  "scripts": {
    "lint:html": "npx --yes htmlhint --rules \"tag-pair=true,attr-value-double-quotes=true,id-unique=true,spec-char-escape=false,src-not-empty=true\" webui/static/index.html",
    "lint:js": "node -c webui/static/*.js",
    "lint:py": "python3 -m ruff check webui/api/",
    "lint": "npm run lint:html && npm run lint:js && npm run lint:py",
    "test": "npm run lint"
  },
  "keywords": [
    "antigravity",
    "cagy",
    "gemini",
    "ai-agent",
    "webui"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/therealkevops/CAGY-v2.0.0.git"
  },
  "license": "MIT"
}
