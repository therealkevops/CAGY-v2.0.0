# =================================================================
# Containerized Antigravity (CAGY) Configuration
# =================================================================

# Optional: Set a password to require authentication when opening the WebUI
# AGY_WEBUI_PASSWORD=your_secure_password_here

# Optional: Override host port binding (default: 8989)
# AGY_WEBUI_PORT=8989

# Optional: AI Provider API keys for custom MCP tools / sidecars
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
